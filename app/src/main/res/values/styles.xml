<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовый стиль для всех кнопок навигации -->
    <style name="NavigationButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:padding">8dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>  <!-- если не хочешь капслок -->
    </style>

    <!-- Стиль для активной кнопки (где выделение) -->
    <style name="NavigationButton.Active" parent="NavigationButton">
        <item name="android:textColor">@color/purple_500</item>
    </style>
</resources>