<resources xmlns:tools2="http://schemas.android.com/tools" xmlns:tools="http://schemas.android.com/apk/res/android" tools2:ignore="NamespaceTypo">
    <!-- Базовая тема приложения (MaterialComponents) -->
    <style name="Base.Theme.CarbonLK" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#007Ac5</item>
        <item name="colorPrimaryVariant">#0062a0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#007Ac5</item>
        <item name="colorSecondaryVariant">#0062a0</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Основная тема приложения -->
    <style name="Theme.CarbonLK" parent="Base.Theme.CarbonLK">
        <!-- Цвет текста по умолчанию для кнопок -->
        <item name="android:textColor">@color/black</item>
        <!-- Цвет акцента для MaterialComponents -->
        <item name="colorPrimary">@color/purple_500</item>
    </style>

    <!-- Тема для сплэш-экрана -->
    <style name="Theme.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowFullscreen">true</item>
    </style>


</resources>