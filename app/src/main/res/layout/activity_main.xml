<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ScrollView с основным контентом -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingBottom="16dp">

            <!-- Заголовок: Здравствуйте, Никита -->
            <TextView
                android:id="@+id/greetingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Здравствуйте, Никита"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Блок: Лицевой счёт, Договор, Баланс -->
            <androidx.cardview.widget.CardView
                android:id="@+id/accountCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:contentPadding="16dp"
                app:layout_constraintTop_toBottomOf="@id/greetingTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Лицевой счёт -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/accountNumberLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Лицевой счёт:"
                            android:textSize="14sp"
                            android:textColor="@color/dark_gray" />

                        <TextView
                            android:id="@+id/accountNumberValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="000464518"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                    <!-- Договор -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/contractLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Договор:"
                            android:textSize="14sp"
                            android:textColor="@color/dark_gray" />

                        <TextView
                            android:id="@+id/contractValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="464518"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                    <!-- Баланс -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            android:id="@+id/balanceLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Баланс:"
                            android:textSize="14sp"
                            android:textColor="@color/dark_gray" />

                        <TextView
                            android:id="@+id/balanceValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1250 р."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Блок: Статус, Тариф, Дата активации -->
            <androidx.cardview.widget.CardView
                android:id="@+id/statusCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:contentPadding="16dp"
                app:layout_constraintTop_toBottomOf="@id/accountCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Статус -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/statusLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Статус:"
                            android:textSize="14sp"
                            android:textColor="@color/dark_gray" />

                        <TextView
                            android:id="@+id/statusValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Активен"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/green" />

                    </LinearLayout>

                    <!-- Тариф -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tariffLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Тариф:"
                            android:textSize="14sp"
                            android:textColor="@color/dark_gray" />

                        <TextView
                            android:id="@+id/tariffValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Белка 100"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                    <!-- Дата активации -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            android:id="@+id/activationDateLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Дата активации:"
                            android:textSize="14sp"
                            android:textColor="@color/dark_gray" />

                        <TextView
                            android:id="@+id/activationDateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2025-05-09"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Блок: Расходы за месяц -->
            <androidx.cardview.widget.CardView
                android:id="@+id/expensesCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:contentPadding="16dp"
                app:layout_constraintTop_toBottomOf="@id/statusCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Заголовок -->
                    <TextView
                        android:id="@+id/expensesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Расходы за месяц:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="12dp" />

                    <!-- Трафик -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/trafficLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Трафик 100 Мбит"
                            android:textSize="14sp"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/trafficExpense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 р."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                    <!-- Абонентская плата -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            android:id="@+id/subscriptionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Абонентская плата"
                            android:textSize="14sp"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/subscriptionExpense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="890 р."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Блок: Обещанный платёж -->
            <androidx.cardview.widget.CardView
                android:id="@+id/paymentCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:contentPadding="16dp"
                app:layout_constraintTop_toBottomOf="@id/expensesCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Заголовок -->
                    <TextView
                        android:id="@+id/paymentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Обещанный платёж"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp" />

                    <!-- RadioGroup для выбора срока -->
                    <RadioGroup
                        android:id="@+id/paymentRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/radio3days"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3 дня"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:buttonTint="@color/purple_500"
                            android:checked="true"
                            android:layout_marginEnd="8dp" />

                        <RadioButton
                            android:id="@+id/radio7days"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="7 дней"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:buttonTint="@color/purple_500"
                            android:layout_marginStart="8dp" />

                    </RadioGroup>

                    <!-- Кнопка Взять -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonTake"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Взять"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Дополнительный отступ снизу, чтобы контент не прилипал к навигации -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp"
                app:layout_constraintTop_toBottomOf="@id/paymentCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Нижняя навигация (всегда внизу) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navHome"
            style="@style/NavigationButton.Active"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Главная"
            android:textColor="@color/purple_500"
            app:icon="@drawable/ic_home"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navServices"
            style="@style/NavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Услуги"
            android:textColor="@color/dark_gray"
            app:icon="@drawable/ic_services"
            app:iconGravity="textTop"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navPayment"
            style="@style/NavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Оплата"
            android:textColor="@color/dark_gray"
            app:icon="@drawable/ic_card"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSupport"
            style="@style/NavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Поддержка"
            android:textColor="@color/dark_gray"
            app:icon="@drawable/ic_support"
            app:iconGravity="textTop" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>