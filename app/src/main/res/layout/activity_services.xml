<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ScrollView с контентом -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingBottom="16dp">

            <!-- Заголовок: Здравствуйте, Никита -->
            <TextView
                android:id="@+id/greetingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Здравствуйте, Никита"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Заголовок раздела: Управление услугами -->
            <TextView
                android:id="@+id/servicesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Управление услугами"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/greetingTextView"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CardView: Управление услугами (Белый IP, Род. контроль) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/quickServicesCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:contentPadding="16dp"
                app:layout_constraintTop_toBottomOf="@id/servicesTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Белый IP (статус Подключен) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/whiteIpLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Белый IP"
                            android:textSize="16sp"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/whiteIpStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Подключен"
                            android:textSize="14sp"
                            android:textColor="@color/green"
                            android:background="@drawable/status_background_gray"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <!-- Родительский контроль -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/parentalControlLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Род. контроль"
                            android:textSize="16sp"
                            android:textColor="@color/black" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/parentalControlButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Подключить"
                            android:textSize="14sp"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/purple_500"
                            android:textColor="@color/white"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Заголовок: Подключенные услуги -->
            <TextView
                android:id="@+id/activeServicesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Подключенные услуги"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/quickServicesCard"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CardView: Подключенные услуги (только подключенные) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/activeServicesCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:contentPadding="16dp"
                app:layout_constraintTop_toBottomOf="@id/activeServicesTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Белка 100 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/belkaName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Белка 100"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/belkaStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Подключен"
                            android:textSize="14sp"
                            android:textColor="@color/green"
                            android:background="@drawable/status_background_gray"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <!-- Белый IP (отдельная строка, не внутри Белки) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/whiteIpInConnected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Белый IP"
                            android:textSize="16sp"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/whiteIpInConnectedStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Подключен"
                            android:textSize="14sp"
                            android:textColor="@color/green"
                            android:background="@drawable/status_background_gray"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <!-- Косуля 500 (подключена) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="0dp">

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Заголовок: Доступные услуги -->
            <TextView
                android:id="@+id/availableServicesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Доступные услуги"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/activeServicesCard"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Список доступных услуг -->
            <LinearLayout
                android:id="@+id/availableServicesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/availableServicesTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Лайка 300 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/laikaName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Лайка 300"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/laikaConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Подключить"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />

                </LinearLayout>

                <!-- Косуля 500 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/kosulyaName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Косуля 500"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kosulyaConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Подключить"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />
                </LinearLayout>

                <!-- Медведь 1000 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/medvedName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Медведь 1000"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/medvedConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Подключить"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />

                </LinearLayout>

                <!-- Видеокамеры -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/camerasName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Видеокамеры"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camerasConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Подключить"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />

                </LinearLayout>

                <!-- Турбокнопка -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/turboName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Турбокнопка"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/turboConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Подключить"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />

                </LinearLayout>

                <!-- IPTV 24TV -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="0dp">

                    <TextView
                        android:id="@+id/iptvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IPTV 24TV"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/iptvConnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Подключить"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/purple_500"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Отступ снизу -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp"
                app:layout_constraintTop_toBottomOf="@id/availableServicesList"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Нижняя навигация -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navHome"
            style="@style/NavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Главная"
            android:textColor="@color/dark_gray"
            app:icon="@drawable/ic_home"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navServices"
            style="@style/NavigationButton.Active"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Услуги"
            android:textColor="@color/purple_500"
            app:icon="@drawable/ic_services"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navPayment"
            style="@style/NavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Оплата"
            android:textColor="@color/dark_gray"
            app:icon="@drawable/ic_card"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSupport"
            style="@style/NavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Поддержка"
            android:textColor="@color/dark_gray"
            app:icon="@drawable/ic_support"
            app:iconGravity="textTop" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>